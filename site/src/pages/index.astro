---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Model from '../components/Model.astro';
import Loop from '../components/Loop.astro';
import Commands from '../components/Commands.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';

const title = 'YouTube CLI (yt-cli) | Dual-Mode YouTube Data API v3 CLI for Humans & Agents';
const description =
  'Open-source Go CLI and Agent Skill for the YouTube Data API v3. Semantic terminal output for human operators and deterministic JSON, headless OAuth, and dry-run upload safety for AI agents.';
---

<Base title={title} description={description}>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "YouTube CLI",
      "alternateName": "yt-cli",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "macOS, Linux, Windows",
      "url": "https://github.com/ghchinoy/yt-cli"
    }
  </script>
  <Nav />
  <main id="main">
    <Hero />
    <Model />
    <Loop />
    <Commands />
    <Install />
  </main>
  <Footer />
</Base>
